<Project>
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>enable</Nullable>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Authors>jeppevinkel</Authors>
    <Copyright>Copyright © jeppevinkel</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jeppevinkel/Palworld.RestClient</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jeppevinkel/Palworld.RestClient</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>palworld;rest;client;game-server;api</PackageTags>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- SourceLink (built into the .NET 8+ SDK, no package reference needed) -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- Deterministic, normalized builds when running in GitHub Actions -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Reproducible restores; enables lock-file based caching in CI -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Fails the pack if the package breaks public API compatibility.
         Uncomment the baseline once your first stable version is on NuGet.org,
         and bump it each time you ship a new stable release. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion> -->
  </PropertyGroup>
</Project>
